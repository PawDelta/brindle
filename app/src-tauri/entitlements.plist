<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What brindle.app itself is signed with (tauri.macos.conf.json). The hardened
     runtime's resource access for Automation and the microphone: with launchd's
     job switched off the daemon is the app's child, so macOS asks about an
     agent's request on the app's behalf, and only if the app is signed for it
     (its usage strings are in Info.plist). The same two as the engine's helper
     app's (scripts/engine/helper/helper.entitlements), which is asked for
     otherwise. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
