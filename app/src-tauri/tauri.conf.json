{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "brindle",
  "version": "../package.json",
  "identifier": "com.pawdelta.brindle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run notices",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "brindle",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../SCHEDULE-A": "SCHEDULE-A",
      "notices/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCNTQyMjdGRjgzMzNFNzUKUldSMVBqUDRmeUpVcTkzZ1dMSVVBbGJDY3VnOXNPYUt6V0VTMFBhWUhpRGlpaDlISGRLU0pYQ0cK",
      "endpoints": ["https://pawdelta.com/brindle/downloads/desktop/latest.json"]
    }
  }
}
