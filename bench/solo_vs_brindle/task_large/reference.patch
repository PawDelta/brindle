+    def record(op: str, ref: str) -> str:
+        values = "".join(f", {ref}.{_q(column)}" for column in info.columns)
+        return (
+            f'    UPDATE "{STATE_TABLE}" SET version = version + 1;\n'
+            f"    INSERT INTO {_q(info.shadow)} ({_SYSTEM_COLUMNS}{shadow_columns})\n"
+            f"    SELECT version, '{op}', {_NOW}, changeset, {ref}.rowid{values}\n"
+            f'    FROM "{STATE_TABLE}";\n'
+        )
