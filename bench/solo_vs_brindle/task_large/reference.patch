+"""
+Row history: change tracking, time travel and undo for tables.
+
+Every tracked table gets four triggers and a shadow table. The triggers write
+one record to the shadow table for each row that is inserted, updated or
+deleted, numbered by a database-wide version counter. Everything else in this
+module reads those records: listing changes, rebuilding a table as it was at
+an earlier version, restoring rows and undoing whole changesets.
+
+The public API lives on :class:`sqlite_utils.db.Table` and
+:class:`sqlite_utils.db.Database` - the functions here implement it.
+"""
+
+import contextlib
+import datetime
+import heapq
+import json
+from collections.abc import Generator, Iterable
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any
+
+from . import db as _db
+
+if TYPE_CHECKING:
+    from .db import Database, Table
+
+#: Every table, trigger and index created by this module starts with this
+PREFIX = "_history_"
+TABLES_TABLE = "_history_tables"
+STATE_TABLE = "_history_state"
+CHANGESETS_TABLE = "_history_changesets"
+SHADOW_PREFIX = "_history_data_"
+TRIGGER_PREFIX = "_history_on_"
+INDEX_PREFIX = "_history_idx_"
+
+_NOW = "strftime('%Y-%m-%d %H:%M:%f', 'now')"
+_TRIGGER_SUFFIXES = ("insert", "update", "rekey", "delete")
+_SYSTEM_COLUMNS = "_version, _op, _at, _changeset, _rowid"
+
+_LEGACY_SYSTEM_COLUMNS = ("_rowid", "_version", "_updated", "_mask")
+_LEGACY_TRIGGER_SUFFIXES = ("insert_history", "update_history", "delete_history")
+
+_CREATE_TABLES_SQL = f"""
+CREATE TABLE IF NOT EXISTS "{TABLES_TABLE}" (
+   name TEXT PRIMARY KEY,
+   exclude TEXT NOT NULL DEFAULT '[]',
+   floor INTEGER NOT NULL DEFAULT 0,
+   enabled_at TEXT
+);
+CREATE TABLE IF NOT EXISTS "{STATE_TABLE}" (
+   id INTEGER PRIMARY KEY CHECK (id = 1),
+   version INTEGER NOT NULL DEFAULT 0,
+   changeset INTEGER
+);
+INSERT OR IGNORE INTO "{STATE_TABLE}" (id, version) VALUES (1, 0);
+CREATE TABLE IF NOT EXISTS "{CHANGESETS_TABLE}" (
+   id INTEGER PRIMARY KEY,
+   message TEXT,
+   author TEXT,
+   created_at TEXT,
+   pruned INTEGER NOT NULL DEFAULT 0
+);
+"""
+
+
+class HistoryError(Exception):
+    "A history operation could not be carried out"
+
+
+class HistoryConflict(HistoryError):
+    """
+    Undoing a changeset would overwrite changes made after it.
+
+    ``conflicts`` is a list of ``(table_name, pk)`` pairs.
+    """
+
+    def __init__(self, message: str, conflicts: list[tuple[str, Any]]):
+        super().__init__(message)
+        self.conflicts = conflicts
+
+
+@dataclass(frozen=True)
+class Change:
+    """
+    One recorded change to one row.
+
+    ``row`` holds the tracked columns after an insert or update, or as they
+    were just before a delete. ``changed`` maps column names to
+    ``(old, new)`` pairs for an update and is empty otherwise.
+    """
+
+    version: int
+    table: str
+    op: str
+    pk: Any
+    row: dict[str, Any]
+    changed: dict[str, tuple[Any, Any]]
+    changeset: int | None
+    at: str
+
+
+@dataclass(frozen=True)
+class Changeset:
+    "A named group of changes created with ``db.changeset()``"
+
+    id: int
+    message: str | None
+    author: str | None
+    created_at: str
+
+
+@dataclass(frozen=True)
+class RowDiff:
+    "How one row differs between two versions - see ``table.diff()``"
+
+    pk: Any
+    before: dict[str, Any] | None
+    after: dict[str, Any] | None
+
+    @property
+    def op(self) -> str:
+        if self.before is None:
+            return "insert"
+        if self.after is None:
+            return "delete"
+        return "update"
+
+
+def _q(identifier: str) -> str:
+    return _db.quote_identifier(identifier)
+
+
+def is_history_table(name: str) -> bool:
+    "Is this one of the tables created by this module?"
+    return name.startswith(PREFIX)
+
+
+def shadow_name(table_name: str) -> str:
+    return SHADOW_PREFIX + table_name
+
+
+def _trigger_names(table_name: str) -> list[str]:
+    return [f"{TRIGGER_PREFIX}{table_name}_{suffix}" for suffix in _TRIGGER_SUFFIXES]
+
+
+def _index_names(table_name: str) -> tuple[str, str]:
+    return (
+        f"{INDEX_PREFIX}{table_name}_key",
+        f"{INDEX_PREFIX}{table_name}_changeset",
+    )
+
+
+def _same(a: Any, b: Any) -> bool:
+    "Strict equality: 1 and 1.0 and '1' are all different values"
+    return type(a) is type(b) and a == b
+
+
+def _as_pk(key: tuple) -> Any:
+    return key[0] if len(key) == 1 else key
+
+
+def _as_key(pk_values: Any) -> tuple:
+    if isinstance(pk_values, (list, tuple)):
+        return tuple(pk_values)
+    return (pk_values,)
+
+
+def has_tables(db: "Database") -> bool:
+    "Have the history bookkeeping tables been created in this database?"
+    # conn.execute, not db.execute: these probes run inside existing code
+    # paths such as transform() and should not show up in their SQL traces
+    return (
+        db.conn.execute(
+            "select 1 from sqlite_master where type = 'table' and name = ?",
+            (STATE_TABLE,),
+        ).fetchone()
+        is not None
+    )
+
+
+def ensure_tables(db: "Database") -> None:
+    if not has_tables(db):
+        with db.atomic():
+            db.executescript(_CREATE_TABLES_SQL)
+
+
+def _meta(db: "Database", table_name: str) -> tuple | None:
+    if not has_tables(db):
+        return None
+    return db.conn.execute(
+        f'select exclude, floor from "{TABLES_TABLE}" where name = ?', (table_name,)
+    ).fetchone()
+
+
+def is_tracked_name(db: "Database", table_name: str) -> bool:
+    return _meta(db, table_name) is not None
+
+
+def is_tracked(table: "Table") -> bool:
+    return is_tracked_name(table.db, table.name) and table.exists()
+
+
+def tracked_names(db: "Database") -> list[str]:
+    "Names of the tables with history enabled, in the order it was enabled"
+    if not has_tables(db):
+        return []
+    existing = set(db.table_names())
+    return [
+        row[0]
+        for row in db.execute(
+            f'select name from "{TABLES_TABLE}" order by rowid'
+        ).fetchall()
+        if row[0] in existing
+    ]
+
+
+class _Tracked:
+    "Everything needed to build SQL for one tracked table"
+
+    def __init__(self, table: "Table"):
+        meta = _meta(table.db, table.name)
+        if meta is None or not table.exists():
+            raise HistoryError(f"History is not enabled for table {table.name}")
+        self.table = table
+        self.db = table.db
+        self.name = table.name
+        self.exclude: list[str] = json.loads(meta[0])
+        self.floor: int = meta[1]
+        self.shadow = shadow_name(table.name)
+        self.pks: list[str] = [] if table.use_rowid else table.pks
+        #: The columns that should be recorded, going by the table as it is now
+        self.live_columns = [
+            column.name for column in table.columns if column.name not in self.exclude
+        ]
+        # The columns that are recorded. A column added behind our back is in
+        # the table but not in the shadow table or the triggers until
+        # _sync_schema() has run, and must not be read from history before then
+        stored = {column.name for column in table.db.table(self.shadow).columns}
+        self.columns = [
+            column for column in self.live_columns if "d_" + column in stored
+        ]
+
+    @property
+    def shadow_columns(self) -> list[str]:
+        return ["d_" + column for column in self.columns]
+
+    @property
+    def shadow_key_columns(self) -> list[str]:
+        return ["d_" + pk for pk in self.pks] if self.pks else ["_rowid"]
+
+    @property
+    def select_list(self) -> str:
+        "The system columns followed by every tracked column"
+        return ", ".join(
+            [_SYSTEM_COLUMNS] + [_q(column) for column in self.shadow_columns]
+        )
+
+    def key_of(self, rowid: int, image: dict[str, Any]) -> tuple:
+        if self.pks:
+            return tuple(image[pk] for pk in self.pks)
+        return (rowid,)
+
+    def check_key(self, key: tuple) -> tuple:
+        expected = len(self.shadow_key_columns)
+        if len(key) != expected:
+            raise _db.NotFoundError(
+                "Need {} primary key value{}".format(
+                    expected, "" if expected == 1 else "s"
+                )
+            )
+        return key
+
+    def match(self, a: str, b: str) -> str:
+        "Do shadow rows aliased a and b describe the same table row?"
+        return " AND ".join(
+            f"{a}.{_q(column)} IS {b}.{_q(column)}"
+            for column in self.shadow_key_columns
+        )
+
+    def match_live(self, live: str, shadow: str) -> str:
+        "Does the table row aliased live match the shadow row aliased shadow?"
+        if not self.pks:
+            return f"{live}.rowid IS {shadow}._rowid"
+        return " AND ".join(
+            f"{live}.{_q(pk)} IS {shadow}.{_q('d_' + pk)}" for pk in self.pks
+        )
+
+    def latest(self, alias: str, upto: str | None = None) -> str:
+        "Is the shadow row aliased alias the newest one for its table row?"
+        limit = f" AND n._version <= {upto}" if upto else ""
+        return (
+            f"NOT EXISTS (SELECT 1 FROM {_q(self.shadow)} n WHERE "
+            f"{self.match('n', alias)} AND n._version > {alias}._version{limit})"
+        )
+
+    @property
+    def shadow_key_where(self) -> str:
+        return " AND ".join(f"{_q(column)} IS ?" for column in self.shadow_key_columns)
+
+    @property
+    def live_key_where(self) -> str:
+        if not self.pks:
+            return "rowid IS ?"
+        return " AND ".join(f"{_q(pk)} IS ?" for pk in self.pks)
+
+    def check_version(self, version: Any) -> int:
+        if isinstance(version, bool) or not isinstance(version, int):
+            raise TypeError("version must be an integer")
+        if version < self.floor:
+            raise HistoryError(
+                f"History of table {self.name} before version {self.floor} "
+                "has been pruned"
+            )
+        return version
+
+
+# Enabling, disabling and keeping the shadow table in step with the table
+
+
+def _check_trackable(table: "Table") -> None:
+    if is_history_table(table.name):
+        raise HistoryError(f"{table.name} is used to store history")
+    if not table.exists():
+        raise HistoryError(f"Table {table.name} does not exist")
+    if table.virtual_table_using is not None:
+        raise HistoryError(f"{table.name} is a virtual table")
+    try:
+        table.db.conn.execute(f"select rowid from {_q(table.name)} limit 0")
+    except _db.OperationalError:
+        raise HistoryError(f"{table.name} is a WITHOUT ROWID table")
+
+
+def _validate_exclude(table: "Table", exclude: Iterable[str]) -> list[str]:
+    columns = [column.name for column in table.columns]
+    resolved = {_db.resolve_casing(name, columns) for name in exclude}
+    unknown = sorted(resolved.difference(columns))
+    if unknown:
+        raise HistoryError(
+            "Cannot exclude columns that do not exist: {}".format(", ".join(unknown))
+        )
+    pks = [] if table.use_rowid else table.pks
+    excluded_pks = [pk for pk in pks if pk in resolved]
+    if excluded_pks:
+        raise HistoryError(
+            "Cannot exclude primary key columns: {}".format(", ".join(excluded_pks))
+        )
+    if len(resolved) == len(columns):
+        raise HistoryError("Cannot exclude every column")
+    return [column for column in columns if column in resolved]
+
+
+def enable(
+    table: "Table", exclude: Iterable[str] | None = None, import_legacy: bool = True
