+        f"CREATE TRIGGER {insert} AFTER INSERT ON {table}\nBEGIN\n"
+        + record("insert", "new")
+        + "END",
+        f"CREATE TRIGGER {update} AFTER UPDATE ON {table}\n"
+        f"WHEN ({same_key}) AND ({changed})\nBEGIN\n" + record("update", "new") + "END",
+        # Changing a primary key retires the old row and starts a new one
+        f"CREATE TRIGGER {rekey} AFTER UPDATE ON {table}\n"
+        f"WHEN NOT ({same_key})\nBEGIN\n"
+        + record("delete", "old")
+        + record("insert", "new")
+        + "END",
+        f"CREATE TRIGGER {delete} AFTER DELETE ON {table}\nBEGIN\n"
+        + record("delete", "old")
+        + "END",
+    ):
+        info.db.execute(sql)
+
+
+def _record_from_select(info: _Tracked, op: str, select: str) -> int:
+    """
+    Write one record per row of ``select``, which must produce ``ord``,
+    ``_rowid`` and then the tracked columns. Versions follow ``ord``.
+    """
+    shadow_columns = "".join(", " + _q(column) for column in info.shadow_columns)
+    source_columns = "".join(", src." + _q(column) for column in info.shadow_columns)
+    count = info.db.execute(
+        f"INSERT INTO {_q(info.shadow)} ({_SYSTEM_COLUMNS}{shadow_columns})\n"
+        f"SELECT st.version + row_number() OVER (ORDER BY src.ord), '{op}', {_NOW}, "
+        f"st.changeset, src._rowid{source_columns}\n"
+        f'FROM ({select}) src, "{STATE_TABLE}" st'
+    ).rowcount
+    if count:
+        info.db.execute(f'UPDATE "{STATE_TABLE}" SET version = version + ?', (count,))
+    return count
+
+
+def _reconcile(table: "Table") -> None:
+    """
+    Record whatever differs between the table and its newest recorded state:
+    deletes, then updates, then inserts, each in rowid order. On a table that
+    has no history yet this records every row as an insert.
+    """
+    info = _Tracked(table)
+    shadow = _q(info.shadow)
+    live = _q(info.name)
+    from_shadow = "".join(f", s.{_q(column)}" for column in info.shadow_columns)
+    from_live = "".join(
+        f", t.{_q(column)} AS {_q('d_' + column)}" for column in info.columns
+    )
+    current = f"s._op != 'delete' AND {info.latest('s')}"
+    differs = " OR ".join(
+        "typeof(t.{c}) IS NOT typeof(s.{d}) OR t.{c} IS NOT s.{d}".format(
+            c=_q(column), d=_q("d_" + column)
+        )
+        for column in info.columns
+    )
+    with info.db.atomic():
+        _record_from_select(
+            info,
+            "delete",
+            f"SELECT s._rowid AS ord, s._rowid AS _rowid{from_shadow} FROM {shadow} s "
+            f"WHERE {current} AND NOT EXISTS "
+            f"(SELECT 1 FROM {live} t WHERE {info.match_live('t', 's')})",
+        )
+        _record_from_select(
+            info,
+            "update",
+            f"SELECT t.rowid AS ord, t.rowid AS _rowid{from_live} FROM {live} t "
+            f"JOIN {shadow} s ON {info.match_live('t', 's')} "
+            f"WHERE {current} AND ({differs})",
+        )
+        _record_from_select(
+            info,
+            "insert",
+            f"SELECT t.rowid AS ord, t.rowid AS _rowid{from_live} FROM {live} t "
+            f"WHERE NOT EXISTS (SELECT 1 FROM {shadow} s "
+            f"WHERE {info.match_live('t', 's')} AND {current})",
+        )
+
+
+# Hooks called from the existing schema-changing methods in db.py
+
+
+def before_transform(table: "Table") -> bool:
+    """
+    Called inside transform()'s transaction before it runs. The triggers are
+    dropped so that a table kept with keep_table= stops recording.
+    """
+    if not is_tracked(table):
+        return False
+    _drop_triggers(table.db, table.name)
+    return True
+
+
+def after_transform(table: "Table", rename: dict[str, str]) -> None:
+    db = table.db
+    meta = _meta(db, table.name)
+    assert meta is not None
+    shadow = db.table(shadow_name(table.name))
+    existing = {column.name for column in shadow.columns}
+    renames = {
+        "d_" + old: "d_" + new
+        for old, new in rename.items()
+        if "d_" + old in existing and old != new
+    }
+    if renames:
+        db.execute(f"DROP INDEX IF EXISTS {_q(_index_names(table.name)[0])}")
+        shadow.transform(rename=renames)
+    _set_exclude(
+        db, table.name, [rename.get(column, column) for column in json.loads(meta[0])]
+    )
+    _sync_schema(table)
+    _reconcile(table)
+
+
+def before_rename(db: "Database", name: str) -> None:
+    _drop_triggers(db, name)
+    for index in _index_names(name):
+        db.execute(f"DROP INDEX IF EXISTS {_q(index)}")
+
+
+def after_rename(db: "Database", name: str, new_name: str) -> None:
+    db.execute(
+        f"ALTER TABLE {_q(shadow_name(name))} RENAME TO {_q(shadow_name(new_name))}"
+    )
+    db.execute(f'update "{TABLES_TABLE}" set name = ? where name = ?', (new_name, name))
+    _sync_schema(db.table(new_name))
+
+
+# Reading the log
+
+
+def version(db: "Database") -> int:
+    if not has_tables(db):
+        return 0
+    return db.execute(f'select version from "{STATE_TABLE}"').fetchone()[0]
+
+
+def normalize_timestamp(timestamp: str | datetime.datetime) -> str:
+    "Convert a datetime or ISO 8601 string to the format history is stored in"
+    if isinstance(timestamp, str):
+        try:
+            timestamp = datetime.datetime.fromisoformat(timestamp.strip())
+        except ValueError:
+            raise ValueError(f"Invalid timestamp: {timestamp!r}")
+    elif not isinstance(timestamp, datetime.datetime):
+        raise ValueError(f"Invalid timestamp: {timestamp!r}")
+    if timestamp.tzinfo is not None:
+        timestamp = timestamp.astimezone(datetime.timezone.utc)
+    return timestamp.strftime("%Y-%m-%d %H:%M:%S.") + "{:03d}".format(
+        timestamp.microsecond // 1000
+    )
+
+
+def version_at(db: "Database", timestamp: str | datetime.datetime) -> int:
+    at = normalize_timestamp(timestamp)
+    best = 0
+    for name in tracked_names(db):
+        found = db.execute(
+            f"select max(_version) from {_q(shadow_name(name))} where _at <= ?", (at,)
+        ).fetchone()[0]
+        best = max(best, found or 0)
+    return best
+
+
+def _image(info: _Tracked, values: Iterable[Any]) -> dict[str, Any]:
+    return dict(zip(info.columns, values))
+
+
+def _change(info: _Tracked, row: tuple) -> Change:
+    version_, op, at, changeset_id, rowid = row[:5]
+    image = _image(info, row[5:])
+    key = info.key_of(rowid, image)
+    changed: dict[str, tuple[Any, Any]] = {}
+    if op == "update":
+        previous = info.db.execute(
+            "select {} from {} where {} and _version < ? "
+            "order by _version desc limit 1".format(
+                ", ".join(_q(column) for column in info.shadow_columns),
+                _q(info.shadow),
+                info.shadow_key_where,
+            ),
+            (*key, version_),
+        ).fetchone()
+        before = _image(info, previous) if previous else {}
+        changed = {
+            column: (before.get(column), value)
+            for column, value in image.items()
+            if not _same(before.get(column), value)
+        }
+    return Change(
+        version=version_,
+        table=info.name,
+        op=op,
+        pk=_as_pk(key),
+        row=image,
+        changed=changed,
+        changeset=changeset_id,
+        at=at,
+    )
+
+
+def changes(
+    table: "Table",
+    since: int = 0,
+    until: int | None = None,
+    changeset: int | None = None,
+    key: tuple | None = None,
+) -> Generator[Change, None, None]:
+    info = _Tracked(table)
+    where = ["_version > ?"]
+    params: list[Any] = [since]
+    if until is not None:
+        where.append("_version <= ?")
+        params.append(until)
+    if changeset is not None:
+        where.append("_changeset = ?")
+        params.append(changeset)
+    if key is not None:
+        where.append(info.shadow_key_where)
+        params.extend(info.check_key(key))
+    rows = info.db.execute(
+        "select {} from {} where {} order by _version".format(
+            info.select_list, _q(info.shadow), " and ".join(where)
+        ),
+        params,
+    ).fetchall()
+    for row in rows:
+        yield _change(info, row)
+
+
+def db_changes(
+    db: "Database",
+    since: int = 0,
+    until: int | None = None,
+    changeset: int | None = None,
+) -> Generator[Change, None, None]:
+    streams = [
+        changes(db.table(name), since=since, until=until, changeset=changeset)
+        for name in tracked_names(db)
+    ]
+    yield from heapq.merge(*streams, key=lambda change: change.version)
+
+
+# Time travel
+
+
+def _state_of_key(info: _Tracked, key: tuple, version_: int) -> dict[str, Any] | None:
+    "The row's tracked columns as of a version, or None if it did not exist"
+    row = info.db.execute(
+        "select _op, {} from {} where {} and _version <= ? "
+        "order by _version desc limit 1".format(
+            ", ".join(_q(column) for column in info.shadow_columns),
+            _q(info.shadow),
+            info.shadow_key_where,
+        ),
+        (*key, version_),
+    ).fetchone()
+    if row is None or row[0] == "delete":
+        return None
+    return _image(info, row[1:])
+
+
+def as_of(table: "Table", version_: int) -> Generator[dict[str, Any], None, None]:
+    info = _Tracked(table)
+    info.check_version(version_)
+    rows = info.db.execute(
+        "select {} from {} s where s._version <= :v and s._op != 'delete' "
+        "and {} order by {}".format(
+            ", ".join("s." + _q(column) for column in info.shadow_columns),
+            _q(info.shadow),
+            info.latest("s", upto=":v"),
+            ", ".join("s." + _q(column) for column in info.shadow_key_columns),
+        ),
+        {"v": version_},
+    ).fetchall()
+    for row in rows:
+        yield _image(info, row)
+
+
+def get_as_of(table: "Table", pk_values: Any, version_: int) -> dict[str, Any]:
+    info = _Tracked(table)
+    info.check_version(version_)
+    state = _state_of_key(info, info.check_key(_as_key(pk_values)), version_)
+    if state is None:
+        raise _db.NotFoundError
+    return state
+
+
+def diff(table: "Table", from_version: int, to_version: int | None = None) -> list:
+    info = _Tracked(table)
+    if to_version is None:
+        to_version = max(version(info.db), from_version)
+    info.check_version(from_version)
+    info.check_version(to_version)
+    low, high = sorted((from_version, to_version))
+    key_columns = ", ".join(_q(column) for column in info.shadow_key_columns)
+    keys = info.db.execute(
+        f"select distinct {key_columns} from {_q(info.shadow)} "
+        f"where _version > ? and _version <= ? order by {key_columns}",
+        (low, high),
+    ).fetchall()
+    diffs = []
+    for key in keys:
+        before = _state_of_key(info, key, from_version)
+        after = _state_of_key(info, key, to_version)
+        if before is None and after is None:
+            continue
+        if (
+            before is not None
+            and after is not None
+            and all(_same(before[column], after[column]) for column in before)
+        ):
+            continue
+        diffs.append(RowDiff(pk=_as_pk(tuple(key)), before=before, after=after))
+    return diffs
+
+
+# Restoring
+
+
+def _apply_state(info: _Tracked, key: tuple, target: dict[str, Any] | None) -> bool:
+    "Make the live row match target (None meaning no row). True if it changed."
+    live_row = info.db.execute(
+        "select {} from {} where {}".format(
+            ", ".join(_q(column) for column in info.columns),
+            _q(info.name),
+            info.live_key_where,
+        ),
+        key,
+    ).fetchone()
+    if target is None:
+        if live_row is None:
+            return False
+        info.db.execute(f"delete from {_q(info.name)} where {info.live_key_where}", key)
+        return True
+    if live_row is None:
+        columns = [_q(column) for column in info.columns]
+        values = [target[column] for column in info.columns]
+        if not info.pks:
+            columns.append("rowid")
+            values.append(key[0])
+        info.db.execute(
+            "insert into {} ({}) values ({})".format(
+                _q(info.name), ", ".join(columns), ", ".join("?" for _ in columns)
+            ),
+            values,
+        )
+        return True
+    live = _image(info, live_row)
+    updates = {
+        column: value
+        for column, value in target.items()
+        if column not in info.pks and not _same(live[column], value)
+    }
+    if not updates:
+        return False
+    info.db.execute(
+        "update {} set {} where {}".format(
+            _q(info.name),
+            ", ".join(f"{_q(column)} = ?" for column in updates),
+            info.live_key_where,
+        ),
+        (*updates.values(), *key),
+    )
+    return True
+
+
+def revert(table: "Table", pk_values: Any, version_: int) -> bool:
+    info = _Tracked(table)
+    info.check_version(version_)
+    key = info.check_key(_as_key(pk_values))
+    with info.db.atomic():
+        return _apply_state(info, key, _state_of_key(info, key, version_))
+
+
+def restore(table: "Table", version_: int) -> int:
+    info = _Tracked(table)
+    info.check_version(version_)
+    diffs = diff(table, version(info.db), version_)
+    # Deletes first and inserts last, so that restored rows are less likely
+    # to collide with rows that are about to go
+    order = {"delete": 0, "update": 1, "insert": 2}
+    diffs.sort(key=lambda row_diff: order[row_diff.op])
+    changed = 0
+    with info.db.atomic():
+        for row_diff in diffs:
+            changed += _apply_state(info, _as_key(row_diff.pk), row_diff.after)
+    return changed
+
+
+def prune(table: "Table", version_: int) -> int:
+    """
+    Squash every change up to and including version_ into one baseline
+    insert per row that existed at that version.
+    """
+    info = _Tracked(table)
+    if isinstance(version_, bool) or not isinstance(version_, int):
+        raise TypeError("version must be an integer")
+    version_ = min(version_, version(info.db))
+    if version_ <= info.floor:
+        return 0
+    shadow = _q(info.shadow)
+    with info.db.atomic():
+        # A changeset that loses any of its changes can no longer be undone
+        info.db.execute(
+            f'update "{CHANGESETS_TABLE}" set pruned = 1 where id in ('
+            f"select _changeset from {shadow} where _version <= ?)",
+            (version_,),
+        )
+        removed = info.db.execute(
+            f"delete from {shadow} where _version in ("
+            f"select s._version from {shadow} s where s._version <= :v "
+            f"and (s._op = 'delete' or not {info.latest('s', upto=':v')}))",
+            {"v": version_},
+        ).rowcount
+        info.db.execute(
+            f"update {shadow} set _op = 'insert' where _version <= ?", (version_,)
+        )
+        info.db.execute(
+            f'update "{TABLES_TABLE}" set floor = ? where name = ?',
+            (version_, info.name),
+        )
+    return removed
+
+
+# Changesets
+
+
+def _changeset_from_row(row: tuple) -> Changeset:
+    return Changeset(id=row[0], message=row[1], author=row[2], created_at=row[3])
+
+
+def get_changeset(db: "Database", changeset_id: int) -> Changeset | None:
+    if not has_tables(db):
+        return None
+    row = db.execute(
+        f'select id, message, author, created_at from "{CHANGESETS_TABLE}" '
+        "where id = ?",
+        (changeset_id,),
+    ).fetchone()
+    return _changeset_from_row(row) if row else None
+
+
+def changesets(db: "Database") -> list[Changeset]:
+    if not has_tables(db):
+        return []
+    return [
+        _changeset_from_row(row)
+        for row in db.execute(
+            f'select id, message, author, created_at from "{CHANGESETS_TABLE}" '
+            "order by id"
+        ).fetchall()
+    ]
+
+
+def open_changeset(db: "Database") -> int | None:
+    "The id of the changeset that is currently open on this connection"
+    if not has_tables(db):
+        return None
+    return db.conn.execute(f'select changeset from "{STATE_TABLE}"').fetchone()[0]
+
+
+@contextlib.contextmanager
+def changeset(
+    db: "Database", message: str | None = None, author: str | None = None
+) -> Generator[Changeset, None, None]:
+    # One transaction covers the whole block, so the open marker in the state
+    # table is never visible to other connections and a failure rolls back
+    # the changes together with the changeset itself
+    with db.atomic():
+        ensure_tables(db)
+        if open_changeset(db) is not None:
+            raise HistoryError("Changesets cannot be nested")
+        started_at = version(db)
+        changeset_id = db.execute(
+            f'insert into "{CHANGESETS_TABLE}" (message, author, created_at) '
+            f"values (?, ?, {_NOW})",
+            (message, author),
+        ).lastrowid
+        db.execute(f'update "{STATE_TABLE}" set changeset = ?', (changeset_id,))
+        created = get_changeset(db, changeset_id)
+        assert created is not None
+        yield created
+        db.execute(f'update "{STATE_TABLE}" set changeset = NULL')
+        if version(db) == started_at:
+            # Nothing was recorded - do not leave an empty changeset behind
+            db.execute(
+                f'delete from "{CHANGESETS_TABLE}" where id = ?', (changeset_id,)
+            )
+
+
+def undo_changeset(
+    db: "Database", changeset_id: int, force: bool = False, author: str | None = None
+) -> Changeset | None:
+    if get_changeset(db, changeset_id) is None:
+        raise HistoryError(f"No changeset with id {changeset_id}")
+    pruned = db.execute(
+        f'select pruned from "{CHANGESETS_TABLE}" where id = ?', (changeset_id,)
+    ).fetchone()[0]
+    if pruned:
+        raise HistoryError(
+            f"Changeset {changeset_id} cannot be undone: some of its changes "
+            "have been pruned"
+        )
+    plan: list[tuple[int, _Tracked, tuple, dict[str, Any] | None]] = []
+    conflicts: list[tuple[str, Any]] = []
+    for name in tracked_names(db):
+        info = _Tracked(db.table(name))
+        key_columns = ", ".join(_q(column) for column in info.shadow_key_columns)
+        touched = db.execute(
+            f"select min(_version), {key_columns} from {_q(info.shadow)} "
+            f"where _changeset = ? group by {key_columns}",
+            (changeset_id,),
+        ).fetchall()
+        for first, *key_values in touched:
+            key = tuple(key_values)
+            changed_since = db.execute(
+                f"select 1 from {_q(info.shadow)} where {info.shadow_key_where} "
+                "and _version > ? and _changeset is not ? limit 1",
+                (*key, first, changeset_id),
+            ).fetchone()
+            if changed_since:
+                conflicts.append((name, _as_pk(key)))
+            plan.append((first, info, key, _state_of_key(info, key, first - 1)))
+    if conflicts and not force:
+        raise HistoryConflict(
+            "Changeset {} cannot be undone, these rows have changed since: {}".format(
+                changeset_id,
+                ", ".join(f"{name} {pk!r}" for name, pk in conflicts),
+            ),
+            conflicts,
+        )
+    # Newest first, the reverse of the order the changes were made in
+    plan.sort(key=lambda item: item[0], reverse=True)
+    with changeset(db, f"Undo changeset {changeset_id}", author) as undo:
+        for _, info, key, state in plan:
+            _apply_state(info, key, state)
+    return get_changeset(db, undo.id)
+
+
+# Importing history recorded by the sqlite-history plugin
+
+
+def _legacy_name(table_name: str) -> str:
+    return f"_{table_name}_history"
+
+
+def _legacy_present(table: "Table") -> bool:
+    legacy = table.db.table(_legacy_name(table.name))
+    if not legacy.exists():
+        return False
+    return set(_LEGACY_SYSTEM_COLUMNS).issubset(c.name for c in legacy.columns)
+
+
+def _format_milliseconds(milliseconds: int) -> str:
+    seconds, millis = divmod(int(milliseconds), 1000)
+    moment = datetime.datetime.fromtimestamp(seconds, datetime.timezone.utc)
+    return moment.strftime("%Y-%m-%d %H:%M:%S.") + f"{millis:03d}"
+
+
+def _import_legacy(table: "Table") -> None:
+    """
+    Replay the records of a sqlite-history table into the shadow table, then
+    remove the legacy table and its triggers.
+
+    Legacy update records only hold the columns named by their bit mask, so
+    each row's full state is rebuilt by replaying its records in the order
+    they were written.
+    """
+    db = table.db
+    info = _Tracked(table)
+    legacy_name = _legacy_name(table.name)
+    legacy_columns = [
+        column.name
+        for column in db.table(legacy_name).columns
+        if column.name not in _LEGACY_SYSTEM_COLUMNS
+    ]
+    for suffix in _LEGACY_TRIGGER_SUFFIXES:
+        db.execute(f"DROP TRIGGER IF EXISTS {_q(f'{table.name}_{suffix}')}")
+    rows = db.execute(
+        "select _rowid, _updated, _mask{} from {} order by rowid".format(
+            "".join(", " + _q(column) for column in legacy_columns), _q(legacy_name)
+        )
+    ).fetchall()
+    images: dict[Any, dict[str, Any]] = {}
+    records: list[tuple[str, Any, dict[str, Any], str | None]] = []
+    for rowid, updated, mask, *values in rows:
+        at = _format_milliseconds(updated) if updated is not None else None
+        recorded = dict(zip(legacy_columns, values))
+        previous = images.get(rowid)
+        if mask is not None and mask < 0:
+            records.append(("delete", rowid, recorded, at))
+            images.pop(rowid, None)
+            continue
+        if previous is None:
+            image = recorded
+            records.append(("insert", rowid, image, at))
+        else:
+            image = dict(previous)
+            for position, column in enumerate(legacy_columns):
+                if mask is None or mask & (1 << position):
+                    image[column] = recorded[column]
+            if any(not _same(previous.get(pk), image.get(pk)) for pk in info.pks):
+                records.append(("delete", rowid, previous, at))
+                records.append(("insert", rowid, image, at))
+            else:
+                records.append(("update", rowid, image, at))
+        images[rowid] = image
+    next_version = version(db)
+    insert_sql = "insert into {} ({}) values (?, ?, coalesce(?, {}), NULL, ?{})".format(
+        _q(info.shadow),
+        info.select_list,
+        _NOW,
+        ", ?" * len(info.columns),
+    )
+    for op, rowid, image, at in records:
+        next_version += 1
+        db.execute(
+            insert_sql,
+            (
+                next_version,
+                op,
+                at,
+                rowid,
+                *(image.get(column) for column in info.columns),
+            ),
+        )
+    db.execute(f'update "{STATE_TABLE}" set version = ?', (next_version,))
+    db.execute(f"DROP TABLE {_q(legacy_name)}")
+
+
+def coerce_pk(table: "Table", values: Iterable[str]) -> tuple:
+    """
+    Convert primary key values given as strings (on the command line) to the
+    types of the table's primary key columns.
+    """
+    types = table.columns_dict
+    pks = table.pks
+    coerced = []
+    for position, value in enumerate(values):
+        target = types.get(pks[position], int) if position < len(pks) else str
+        if target in (int, float):
+            try:
+                coerced.append(target(value))
+                continue
+            except ValueError:
+                pass
+        coerced.append(value)
+    return tuple(coerced)
