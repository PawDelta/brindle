+    db = table.db
+    _check_trackable(table)
+    with db.atomic():
+        ensure_tables(db)
+        fresh = _meta(db, table.name) is None
+        if fresh:
+            db.execute(
+                f'insert into "{TABLES_TABLE}" (name, exclude, enabled_at) '
+                f"values (?, ?, {_NOW})",
+                (table.name, json.dumps(_validate_exclude(table, exclude or []))),
+            )
+        elif exclude is not None:
+            _set_exclude(db, table.name, _validate_exclude(table, exclude))
+        _sync_schema(table)
+        if fresh and import_legacy and _legacy_present(table):
+            _import_legacy(table)
+        _reconcile(table)
+
+
+def disable(table: "Table") -> None:
+    _Tracked(table)  # raises HistoryError if the table is not tracked
+    with table.db.atomic():
+        _drop_triggers(table.db, table.name)
+        forget(table.db, table.name)
+
+
+def forget(db: "Database", table_name: str) -> None:
+    "Delete the recorded history and bookkeeping for a table"
+    db.execute(f"DROP TABLE IF EXISTS {_q(shadow_name(table_name))}")
+    db.execute(f'delete from "{TABLES_TABLE}" where name = ?', (table_name,))
+
+
+def resync(table: "Table") -> None:
+    "Bring tracking back in line after the table's columns or rows changed"
+    with table.db.atomic():
+        _sync_schema(table)
+        _reconcile(table)
+
+
+def _set_exclude(db: "Database", table_name: str, exclude: list[str]) -> None:
+    db.execute(
+        f'update "{TABLES_TABLE}" set exclude = ? where name = ?',
+        (json.dumps(exclude), table_name),
+    )
+
+
+def _drop_triggers(db: "Database", table_name: str) -> None:
+    for name in _trigger_names(table_name):
+        db.execute(f"DROP TRIGGER IF EXISTS {_q(name)}")
+
+
+def _sync_schema(table: "Table") -> None:
+    """
+    Make the shadow table, its indexes and the triggers match the table's
+    current columns and primary key. Recorded history is kept, apart from
+    columns that are no longer tracked.
+    """
+    db = table.db
+    info = _Tracked(table)
+    # Excluded columns can vanish, or become part of the primary key
+    exclude = [
+        column
+        for column in info.exclude
+        if column in table.columns_dict and column not in info.pks
+    ]
+    if exclude != info.exclude:
+        _set_exclude(db, table.name, exclude)
+        info = _Tracked(table)
+    key_index, changeset_index = _index_names(table.name)
+    shadow = db.table(info.shadow)
+    wanted = ["d_" + column for column in info.live_columns]
+    _drop_triggers(db, table.name)
+    db.execute(f"DROP INDEX IF EXISTS {_q(key_index)}")
+    # Data columns are declared BLOB, which gives them no type affinity:
+    # every value is stored exactly as the table held it
+    if not shadow.exists():
+        columns = "".join(f",\n   {_q(column)} BLOB" for column in wanted)
+        db.execute(
+            f"CREATE TABLE {_q(info.shadow)} (\n"
+            "   _version INTEGER PRIMARY KEY,\n"
+            "   _op TEXT NOT NULL,\n"
+            "   _at TEXT NOT NULL,\n"
+            "   _changeset INTEGER,\n"
+            f"   _rowid INTEGER{columns}\n)"
+        )
+    else:
+        existing = [
+            column.name for column in shadow.columns if column.name.startswith("d_")
+        ]
+        stale = [column for column in existing if column not in wanted]
+        if stale:
+            shadow.transform(drop=stale)
+        for column in wanted:
+            if column not in existing:
+                db.execute(
+                    f"ALTER TABLE {_q(info.shadow)} ADD COLUMN {_q(column)} BLOB"
+                )
+    # From here on the recorded columns are the table's columns
+    info = _Tracked(table)
+    db.execute(
+        "CREATE INDEX {} ON {} ({}, _version)".format(
+            _q(key_index),
+            _q(info.shadow),
+            ", ".join(_q(column) for column in info.shadow_key_columns),
+        )
+    )
+    db.execute(
+        f"CREATE INDEX IF NOT EXISTS {_q(changeset_index)} "
+        f"ON {_q(info.shadow)} (_changeset)"
+    )
+    _create_triggers(info)
+
+
+def _create_triggers(info: _Tracked) -> None:
+    table = _q(info.name)
+    shadow_columns = "".join(", " + _q(column) for column in info.shadow_columns)
