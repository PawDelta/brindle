+def restore(path, dbtable, version, pk_values, load_extension):
+    """Put a table, or one of its rows, back to how it was at an earlier version
+
+    VERSION is a history version number, or a timestamp. Outputs the number
+    of rows that were changed.
+
+    Example:
+
+    \b
+        sqlite-utils restore chickens.db chickens 42
+
+    Add primary key values to restore just that row:
+
+    \b
+        sqlite-utils restore chickens.db chickens 42 3
+    """
+    db = sqlite_utils.Database(path)
+    _register_db_for_cleanup(db)
+    _load_extensions(db, load_extension)
+    try:
+        (history_table,) = _existing_tables(db, [dbtable])
+        version = _history_version(db, version)
+        if pk_values:
+            changed = int(
+                history_table.revert(coerce_pk(history_table, pk_values), version)
+            )
+        else:
+            changed = history_table.restore(version)
+    except (HistoryError, NotFoundError, sqlite3.DatabaseError) as e:
+        raise click.ClickException(str(e) or "Row not found")
+    click.echo(changed)
+
