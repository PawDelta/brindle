+        same_key = " AND ".join(f"old.{_q(pk)} IS new.{_q(pk)}" for pk in info.pks)
+    else:
+        same_key = "old.rowid IS new.rowid"
+    # IS NOT alone treats the integer 1 and the real 1.0 as the same value,
+    # so the storage class is compared as well - as _reconcile() does
+    changed = " OR ".join(
+        "old.{c} IS NOT new.{c} OR typeof(old.{c}) IS NOT typeof(new.{c})".format(
+            c=_q(column)
+        )
