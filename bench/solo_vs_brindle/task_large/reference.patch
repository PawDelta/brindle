+import json
+
+import pytest
+from click.testing import CliRunner
+
+from sqlite_utils import Database, Migrations, cli
+from sqlite_utils.db import NotFoundError
+from sqlite_utils.history import HistoryConflict, HistoryError
+
+CLEO = {"id": 1, "name": "Cleo", "age": 4}
+PANCAKES = {"id": 2, "name": "Pancakes", "age": 2}
+
+
+@pytest.fixture
+def dogs(fresh_db):
+    table = fresh_db.table("dogs", pk="id")
+    table.insert_all([CLEO, PANCAKES])
+    table.enable_history()
+    return table
+
+
+def summary(changes):
+    return [(change.version, change.op, change.pk) for change in changes]
+
+
+def test_enable_history_records_existing_rows(fresh_db, dogs):
+    assert dogs.has_history
+    assert fresh_db.history_tables() == ["dogs"]
+    assert summary(dogs.changes()) == [(1, "insert", 1), (2, "insert", 2)]
+    assert fresh_db.history_version == 2
+    assert all(name.startswith("_history_") for name in fresh_db.table_names()[1:])
+
+
+@pytest.mark.parametrize(
+    "setup",
+    (
+        "create virtual table t using fts5(a)",
+        "create table t (a text primary key) without rowid",
+        "create view t as select 1",
+        "select 1",
+    ),
+)
+def test_enable_history_refuses_unsuitable_tables(fresh_db, setup):
+    fresh_db.execute(setup)
+    with pytest.raises(Exception) as ex:
+        fresh_db.table("t").enable_history()
+    assert ex.type.__name__ in ("HistoryError", "NoTable")
+
+
+def test_changes_are_recorded_however_they_are_made(fresh_db, dogs):
+    dogs.update(1, {"age": 5})
+    dogs.update(1, {"age": 5})
+    fresh_db.execute("update dogs set id = 20 where id = 2")
+    dogs.insert({"id": 1, "name": "Cleopaws", "age": 5}, replace=True)
+    dogs.delete(20)
+    changes = list(dogs.changes(since=2))
+    assert summary(changes) == [
+        (3, "update", 1),
+        (4, "delete", 2),
+        (5, "insert", 20),
+        (6, "delete", 1),
+        (7, "insert", 1),
+        (8, "delete", 20),
+    ]
+    assert changes[0].changed == {"age": (4, 5)}
+    assert changes[-1].row == {"id": 20, "name": "Pancakes", "age": 2}
+    assert summary(dogs.history(20)) == [(5, "insert", 20), (8, "delete", 20)]
+
+
+def test_rolled_back_changes_are_not_recorded(fresh_db, dogs):
+    with pytest.raises(ZeroDivisionError):
+        with fresh_db.atomic():
+            dogs.delete(1)
+            1 / 0
+    assert fresh_db.history_version == 2
+
+
+def test_change_of_storage_class_is_recorded(fresh_db):
+    # 1 and 1.0 compare equal in SQLite but are different stored values
+    table = fresh_db.table("loose", pk="id")
+    table.create({"id": int, "value": bytes})
+    table.insert({"id": 1, "value": 1})
+    table.enable_history()
+    fresh_db.execute("update loose set value = 1.0")
+    fresh_db.execute("update loose set value = 1.0")
+    changes = list(table.changes())
+    assert summary(changes) == [(1, "insert", 1), (2, "update", 1)]
+    assert [type(c.row["value"]) for c in changes] == [int, float]
+    assert type(table.get_as_of(1, 1)["value"]) is int
+
+
+def test_column_added_with_raw_sql_waits_for_enable_history(fresh_db, dogs):
+    fresh_db.execute("alter table dogs add column breed text default 'mutt'")
+    assert dogs.history_columns == ["id", "name", "age"]
+    assert [change.row for change in dogs.changes()] == [CLEO, PANCAKES]
+    assert list(dogs.as_of(2)) == [CLEO, PANCAKES]
+    dogs.update(1, {"age": 5, "breed": "corgi"})
+    assert list(dogs.changes())[-1].row == dict(CLEO, age=5)
+    dogs.enable_history()
+    assert dogs.history_columns == ["id", "name", "age", "breed"]
+    assert list(dogs.as_of(fresh_db.history_version)) == list(dogs.rows)
+
+
+def test_time_travel_and_diff(fresh_db, dogs):
+    dogs.update(2, {"age": 3})
+    dogs.delete(1)
+    assert list(dogs.as_of(2)) == [CLEO, PANCAKES]
+    assert list(dogs.as_of(4)) == [dict(PANCAKES, age=3)]
+    assert dogs.get_as_of(1, 3) == CLEO
+    with pytest.raises(NotFoundError):
+        dogs.get_as_of(1, 4)
+    assert [(d.pk, d.op) for d in dogs.diff(2)] == [(1, "delete"), (2, "update")]
+    assert [(d.pk, d.op) for d in dogs.diff(4, 2)] == [(1, "insert"), (2, "update")]
+
+
+def test_revert_and_restore(fresh_db, dogs):
+    dogs.update(2, {"age": 3})
+    dogs.delete(1)
+    dogs.insert({"id": 3, "name": "Marnie", "age": 9})
+    assert dogs.revert(2, 2) is True
+    assert dogs.revert(2, 2) is False
+    assert dogs.restore(2) == 2
+    assert list(dogs.rows_where(order_by="id")) == [CLEO, PANCAKES]
+    assert list(dogs.as_of(fresh_db.history_version)) == [CLEO, PANCAKES]
+
+
+def test_changeset_and_undo(fresh_db, dogs):
+    with fresh_db.changeset("Birthday", author="cleo") as changeset:
+        dogs.update(1, {"age": 5})
+        dogs.insert({"id": 3, "name": "Marnie", "age": 9})
+    assert [c.changeset for c in dogs.changes(since=2)] == [changeset.id] * 2
+    assert [c.message for c in fresh_db.changesets()] == ["Birthday"]
+    dogs.update(1, {"name": "Cleopaws"})
+    with pytest.raises(HistoryConflict) as ex:
+        fresh_db.undo_changeset(changeset.id)
+    assert ex.value.conflicts == [("dogs", 1)]
+    undo = fresh_db.undo_changeset(changeset.id, force=True)
+    assert undo.message == f"Undo changeset {changeset.id}"
+    assert list(dogs.rows_where(order_by="id")) == [CLEO, PANCAKES]
+
+
+def test_changeset_rolls_back_and_cannot_nest(fresh_db, dogs):
+    with pytest.raises(HistoryError):
+        with fresh_db.changeset("outer"):
+            dogs.delete(1)
+            with fresh_db.changeset("inner"):
+                pass
+    assert dogs.count == 2
+    assert fresh_db.changesets() == []
+
+
+def test_migration_is_recorded_as_changeset(fresh_db, dogs):
+    migrations = Migrations("pets")
+
+    @migrations()
+    def older(db):
+        db.execute("update dogs set age = age + 1")
+
+    migrations.apply(fresh_db)
+    assert [c.message for c in fresh_db.changesets()] == ["Migration pets:older"]
+
+
+def test_history_follows_schema_changes(fresh_db, dogs):
+    dogs.add_column("breed", str, not_null_default="mutt")
+    dogs.transform(rename={"age": "years"}, drop=["breed"])
+    fresh_db.rename_table("dogs", "hounds")
+    hounds = fresh_db.table("hounds")
+    assert hounds.history_columns == ["id", "name", "years"]
+    assert list(hounds.as_of(1)) == [{"id": 1, "name": "Cleo", "years": 4}]
+    hounds.update(1, {"years": 5})
+    assert list(hounds.changes())[-1].changed == {"years": (4, 5)}
+    assert list(hounds.as_of(fresh_db.history_version)) == list(hounds.rows)
+    hounds.drop()
+    assert fresh_db.history_tables() == []
+
+
+def test_exclude_and_reenable(fresh_db):
+    table = fresh_db.table("pages", pk="id")
+    table.insert({"id": 1, "title": "Home", "hits": 0})
+    with pytest.raises(HistoryError):
+        table.enable_history(exclude=["id"])
+    table.enable_history(exclude=["hits"])
+    table.update(1, {"hits": 1})
+    assert fresh_db.history_version == 1
+    table.enable_history(exclude=[])
+    assert list(table.changes())[-1].changed == {"hits": (None, 1)}
+
+
+def test_prune_history(fresh_db, dogs):
+    dogs.update(1, {"age": 5})
+    dogs.delete(2)
+    assert dogs.prune_history(3) == 1
+    assert dogs.history_floor == 3
+    assert summary(dogs.changes()) == [
+        (2, "insert", 2),
+        (3, "insert", 1),
+        (4, "delete", 2),
+    ]
+    with pytest.raises(HistoryError):
+        list(dogs.as_of(2))
+    assert list(dogs.as_of(3)) == [dict(CLEO, age=5), PANCAKES]
+
+
+def test_import_legacy_history(fresh_db):
+    fresh_db.executescript("""
+        create table docs (id integer primary key, title text, body text);
+        create table _docs_history (
+            _rowid integer, id integer, title text, body text,
+            _version integer, _updated integer, _mask integer
+        );
+        insert into docs values (1, 'Intro', null);
+        insert into _docs_history values (1, 1, 'Draft', 'x', 1, 1704164645678, 7);
+        insert into _docs_history values (1, null, 'Intro', null, 2, 1704164646678, 6);
+        insert into _docs_history values (2, 2, 'Gone', 'y', 1, 1704164647678, 7);
+        insert into _docs_history values (2, 2, 'Gone', 'y', 2, 1704164648678, -1);
+    """)
+    docs = fresh_db.table("docs")
+    docs.enable_history()
+    changes = list(docs.changes())
+    assert summary(changes) == [
+        (1, "insert", 1),
+        (2, "update", 1),
+        (3, "insert", 2),
+        (4, "delete", 2),
+    ]
+    assert changes[0].at == "2024-01-02 03:04:05.678"
+    assert changes[1].row == {"id": 1, "title": "Intro", "body": None}
+    assert fresh_db.history_version_at("2024-01-02 03:04:06") == 1
+    assert "_docs_history" not in fresh_db.table_names()
+
