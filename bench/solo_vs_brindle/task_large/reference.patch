+def test_cli_history_commands(tmpdir):
+    path = str(tmpdir / "dogs.db")
+    db = Database(path)
+    db.table("dogs", pk="id").insert_all([CLEO, PANCAKES])
+    db.close()
+    runner = CliRunner()
+
+    def run(*args, input=None):
+        result = runner.invoke(cli.cli, [str(arg) for arg in args], input=input)
+        assert result.exit_code == 0, result.output
+        return result.output
+
+    run("enable-history", path, "dogs")
+    upsert = ["upsert", path, "dogs", "-", "--pk", "id", "--changeset", "Older"]
+    run(*upsert, input=json.dumps(dict(CLEO, age=5)))
+    history = json.loads(run("history", path, "dogs", "1"))
+    assert [(c["version"], c["op"]) for c in history] == [(1, "insert"), (3, "update")]
+    assert history[1]["changed"] == {"age": [4, 5]}
+    assert json.loads(run("as-of", path, "dogs", "2")) == [CLEO, PANCAKES]
+    (changeset,) = json.loads(run("changesets", path))
+    assert changeset["message"] == "Older"
+    assert run("undo", path, changeset["id"]).strip() == "2"
+    assert run("restore", path, "dogs", "3").strip() == "1"
+    assert run("prune-history", path, "dogs", "2999-01-01").strip() == "3"
+    run("disable-history", path, "dogs")
+    assert runner.invoke(cli.cli, ["history", path, "dogs"]).exit_code == 1
