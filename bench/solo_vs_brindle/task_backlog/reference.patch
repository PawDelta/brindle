new file mode 100644
index 0000000..7731e54
--- /dev/null
+++ b/tests/test_types/test_Duration.py
@@ -0,0 +1,51 @@
+from datetime import timedelta
+
+import pytest
+
+import click
+
+
+@pytest.mark.parametrize(
+    ("value", "expect"),
+    [
+        ("90", timedelta(seconds=90)),
+        ("1h30m", timedelta(hours=1, minutes=30)),
+        ("1D 2h", timedelta(days=1, hours=2)),
+        ("250ms", timedelta(milliseconds=250)),
+        (timedelta(minutes=1), timedelta(minutes=1)),
+        (5, timedelta(seconds=5)),
+    ],
+)
+def test_duration_convert(value, expect):
+    assert click.Duration().convert(value, None, None) == expect
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["", "1 h", "30m1h", "1h1h", "-1s", True, "9" * 21 + "s", float("inf")],
+)
+def test_duration_invalid(value):
+    with pytest.raises(click.BadParameter):
+        click.Duration().convert(value, None, None)
+
+
+def test_duration_bounds():
+    duration = click.Duration(min=1, max=timedelta(minutes=1))
+    assert duration.convert("60s", None, None) == timedelta(minutes=1)
+
+    with pytest.raises(click.BadParameter):
+        duration.convert("61s", None, None)
+
+    with pytest.raises(ValueError):
+        click.Duration(min=10, max=5)
+
+
+def test_duration_from_timedelta_type(runner):
+    @click.command()
+    @click.option("--every", type=timedelta)
+    @click.option("--wait", default=timedelta(seconds=5))
+    def cli(every, wait):
+        click.echo(f"{every} {wait}")
+
+    result = runner.invoke(cli, ["--every", "2m"])
+    assert result.output == "0:02:00 0:00:05\n"
diff --git a/tests/test_utils/test_get_app_dir.py b/tests/test_utils/test_get_app_dir.py
new file mode 100644
index 0000000..f602bef
--- /dev/null
+++ b/tests/test_utils/test_get_app_dir.py
@@ -0,0 +1,58 @@
+import os
+import sys
+
+import pytest
+
+import click
+
+
+@pytest.fixture
+def linux_home(tmp_path, monkeypatch):
+    monkeypatch.setattr(sys, "platform", "linux")
+    monkeypatch.setenv("HOME", str(tmp_path))
+    for kind in ("CONFIG", "DATA", "CACHE", "STATE"):
+        monkeypatch.delenv(f"XDG_{kind}_HOME", raising=False)
+    return str(tmp_path)
+
+
+@pytest.mark.parametrize(
+    ("kind", "default"),
+    [
+        ("config", ".config"),
+        ("data", os.path.join(".local", "share")),
+        ("cache", ".cache"),
+        ("state", os.path.join(".local", "state")),
+    ],
+)
+def test_get_app_dir_kinds(linux_home, monkeypatch, kind, default):
+    expect = os.path.join(linux_home, default, "foo-bar")
+    assert click.get_app_dir("Foo Bar", kind=kind) == expect
+
+    # Empty and relative values are invalid per the XDG spec and ignored.
+    for value in ("", "relative"):
+        monkeypatch.setenv(f"XDG_{kind.upper()}_HOME", value)
+        assert click.get_app_dir("Foo Bar", kind=kind) == expect
+
+    monkeypatch.setenv(f"XDG_{kind.upper()}_HOME", "/xdg")
+    assert click.get_app_dir("Foo Bar", kind=kind) == os.path.join("/xdg", "foo-bar")
+
+
+def test_get_app_dir_force_posix(linux_home):
+    assert click.get_app_dir("Foo Bar", force_posix=True) == os.path.join(
+        linux_home, ".foo-bar"
+    )
+    assert click.get_app_dir("Foo Bar", force_posix=True, kind="cache") == (
+        os.path.join(linux_home, ".foo-bar", "cache")
+    )
+
+
+def test_get_app_dir_macos_cache(linux_home, monkeypatch):
+    monkeypatch.setattr(sys, "platform", "darwin")
+    assert click.get_app_dir("Foo Bar", kind="cache") == os.path.join(
+        linux_home, "Library", "Caches", "Foo Bar"
+    )
+
+
+def test_get_app_dir_invalid_kind():
+    with pytest.raises(ValueError):
+        click.get_app_dir("Foo Bar", kind="logs")
