+class DurationInfoDict(ParamTypeInfoDict):
+    min: float | None
+    max: float | None
+
+
+# Units in the order they must appear, longest first, with their keyword for
+# timedelta. "ms" comes before "m" in the pattern so "5ms" is not read as
+# five minutes followed by a stray "s".
+_DURATION_UNITS: t.Final[dict[str, str]] = {
+    "w": "weeks",
+    "d": "days",
+    "h": "hours",
+    "m": "minutes",
+    "s": "seconds",
+    "ms": "milliseconds",
+}
+_DURATION_NUMBER = r"\d+(?:\.\d+)?"
+_duration_bare_re = re.compile(_DURATION_NUMBER)
+_duration_part_re = re.compile(rf"({_DURATION_NUMBER})(ms|w|d|h|m|s)", re.IGNORECASE)
+_duration_re = re.compile(
+    rf"(?:{_DURATION_NUMBER}(?:ms|w|d|h|m|s)\s*)+", re.IGNORECASE
+)
+
+
+def _seconds_to_timedelta(value: timedelta | float) -> timedelta:
+    if isinstance(value, timedelta):
+        return value
+    return timedelta(seconds=value)
+
+
+class Duration(ParamType[timedelta]):
+    """A length of time, converted to a :class:`datetime.timedelta`.
+
+    Accepts one or more components made of a number and a unit, such as
+    ``90s``, ``1h30m`` or ``1.5d``, optionally separated by whitespace. The
+    units are ``w`` (weeks), ``d`` (days), ``h`` (hours), ``m`` (minutes),
+    ``s`` (seconds) and ``ms`` (milliseconds), in that order, each at most
+    once, in any letter case. A bare number is a number of seconds. A
+    :class:`~datetime.timedelta`, or an ``int`` or ``float`` number of seconds,
+    is accepted as is.
+
+    :param min: The smallest accepted duration, inclusive. A timedelta or a
+        number of seconds.
+    :param max: The largest accepted duration, inclusive. A timedelta or a
+        number of seconds.
+
+    .. versionadded:: 8.6.0
+    """
+
+    name = "duration"
+
+    def __init__(
+        self,
+        min: timedelta | float | None = None,
+        max: timedelta | float | None = None,
+    ) -> None:
+        self.min = None if min is None else _seconds_to_timedelta(min)
+        self.max = None if max is None else _seconds_to_timedelta(max)
+
+        if self.min is not None and self.max is not None and self.min > self.max:
+            raise ValueError("'min' must not be greater than 'max'.")
+
+    def to_info_dict(self) -> DurationInfoDict:
+        info_dict = t.cast(DurationInfoDict, super().to_info_dict())
+        info_dict["min"] = None if self.min is None else self.min.total_seconds()
+        info_dict["max"] = None if self.max is None else self.max.total_seconds()
+        return info_dict
+
+    def get_metavar(self, param: Parameter, ctx: Context) -> str:
+        return "DURATION"
+
+    def _parse(self, value: str) -> timedelta | None:
+        text = value.strip()
+
+        if _duration_bare_re.fullmatch(text):
+            return timedelta(seconds=float(text))
+
+        if not _duration_re.fullmatch(text):
+            return None
+
+        order = list(_DURATION_UNITS)
+        last = -1
+        total = timedelta()
+
+        for match in _duration_part_re.finditer(text):
+            unit = match.group(2).lower()
+            index = order.index(unit)
+
+            if index <= last:
+                return None
+
+            last = index
+            total += timedelta(**{_DURATION_UNITS[unit]: float(match.group(1))})
+
+        return total
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> timedelta:
+        result: timedelta | None = None
+
+        # A number too large for a timedelta raises OverflowError, and NaN
+        # raises ValueError: both are invalid input, not a crash.
+        try:
+            if isinstance(value, timedelta):
+                result = value
+            elif isinstance(value, (int, float)) and not isinstance(value, bool):
+                result = timedelta(seconds=value) if value >= 0 else None
+            elif isinstance(value, str):
+                result = self._parse(value)
+        except (OverflowError, ValueError):
+            result = None
+
+        if result is None:
+            self.fail(
+                _("{value!r} is not a valid duration.").format(value=value),
+                param,
+                ctx,
+            )
+
+        if (self.min is not None and result < self.min) or (
+            self.max is not None and result > self.max
+        ):
+            self.fail(
+                _("{value!r} is not in the range {range}.").format(
+                    value=value, range=self._describe_range()
+                ),
+                param,
+                ctx,
+            )
+
+        return result
+
+    def _describe_range(self) -> str:
+        if self.min is None:
+            return f"<={self.max}"
+        if self.max is None:
+            return f">={self.min}"
+        return f"{self.min} to {self.max}"
+
+    def __repr__(self) -> str:
+        return "DURATION"
+
