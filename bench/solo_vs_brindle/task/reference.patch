+class _MissingType:
+    """
+    Marker for a field path that does not resolve in a document.
+    """
+
+    def __repr__(self):
+        return 'MISSING'
+
+
+#: Returned by :func:`resolve_path` when a field path does not resolve
+MISSING = _MissingType()
+
+
+def resolve_path(doc, path: str):
+    """
+    Resolve a dotted field path (``"a.b.c"``) in a document.
+
+    Returns :data:`MISSING` if a key along the path doesn't exist or an
+    intermediate value is not a mapping. Lists are never traversed.
+    """
+    value = doc
+    for key in path.split('.'):
+        if not isinstance(value, abc.Mapping) or key not in value:
+            return MISSING
+        value = value[key]
+    return value
+
+
+def project_paths(doc, paths) -> dict:
+    """
+    Build a new dict holding only the given field paths of ``doc``, keeping
+    their nesting. Paths that don't resolve are left out. Values are deep
+    copies, so the result shares nothing with ``doc``.
+    """
+    result: dict = {}
+    for path in paths:
+        value = resolve_path(doc, path)
+        if value is MISSING:
+            continue
+        keys = path.split('.')
+        target = result
+        for key in keys[:-1]:
+            child = target.get(key)
+            if not isinstance(child, dict):
+                child = target[key] = {}
+            target = child
+        target[keys[-1]] = deepcopy(value)
+    return result
