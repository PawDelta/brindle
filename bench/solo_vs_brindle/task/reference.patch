@@ -0,0 +1,52 @@
+import pytest
+
+from tinydb import TinyDB, UniqueViolation, where
+from tinydb.storages import MemoryStorage
+
+
+@pytest.fixture
+def table():
+    table = TinyDB(storage=MemoryStorage).table('t')
+    table.insert_multiple([
+        {'name': 'a', 'age': 30, 'city': {'name': 'Oslo'}},
+        {'name': 'b', 'age': 20},
+        {'name': 'c', 'age': None, 'city': {'name': 'Alta'}},
+        {'name': 'd', 'age': 20},
+    ])
+    return table
+
+
+def test_find_orders_paginates_and_projects(table):
+    docs = table.find(order_by=['-age', 'name'], skip=1, limit=2,
+                      fields=['name', 'city.name'])
+    assert docs == [{'name': 'b'}, {'name': 'd'}]
+    assert [doc.doc_id for doc in docs] == [2, 4]
+    assert [d['name'] for d in table.find(order_by='age')] == \
+        ['b', 'd', 'a', 'c']
+
+
+def test_aggregation(table):
+    assert table.distinct('age') == [30, 20]
+    assert table.aggregate('age', 'sum') == 70
+    assert table.aggregate('age', 'avg') == pytest.approx(70 / 3)
+    assert list(table.group_by('age')) == [30, 20, None]
+    with pytest.raises(TypeError):
+        table.aggregate('name', 'sum')
+
+
+def test_unique_rejects_without_partial_writes(table):
+    table.ensure_unique('name')
+    with pytest.raises(UniqueViolation):
+        table.update(lambda doc: doc.update(name='x'), where('age') == 20)
+    assert [d['name'] for d in table.all()] == ['a', 'b', 'c', 'd']
+
+
+def test_watch_reports_changes(table):
+    events = []
+    unwatch = table.watch(lambda *event: events.append(event))
+    table.update({'age': 21}, where('name') == 'b')
+    table.update({'age': 21}, where('name') == 'b')
+    unwatch()
+    table.remove(doc_ids=[1])
+    assert events == [('update', 2, {'name': 'b', 'age': 20},
+                       {'name': 'b', 'age': 21})]
